# Balanced pro profile (recommended production default)
# Sweet spot: senior quality where it matters, mini/nano only on hot paths.
# Copy values into Railway API service variables (never commit secrets).

# ---- Routing strategy ----
# balanced = short prompts → fast model; long/complex → primary/quality.
AGENT_LLM_BUDGET_MODE=balanced

# ---- OpenAI core (agent + structured) ----
# gpt-4.1: strong reasoning, ~40-60% cheaper than gpt-5.x for most turns.
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_QUALITY=gpt-4.1
OPENAI_TEMPERATURE=0.15
OPENAI_MAX_COMPLETION_TOKENS=1400
OPENAI_STRUCTURED_MAX_OUTPUT_TOKENS=900
OPENAI_STRUCTURED_MAX_COMPLETION_TOKENS=900

# ---- Transactions modal (structured Responses API) ----
TRANSACTIONS_SUMMARY_MODEL=gpt-4.1-mini
TRANSACTIONS_CHAT_MODEL=gpt-4.1-mini
TRANSACTIONS_RECONCILE_MODEL=gpt-4.1-mini

# ---- Vision / OCR (photos, PDF escaneado) ----
# mini first pass (cheap); full 4.1 only on retry when OCR is sparse.
TRANSACTIONS_VISION_MODEL=gpt-4.1-mini
TRANSACTIONS_VISION_FALLBACK_MODEL=gpt-4.1
TRANSACTIONS_VISION_DETAIL=high
TRANSACTIONS_PROFILE_MODEL=gpt-4.1-mini
TRANSACTIONS_RECONCILE_MODEL=gpt-4.1-mini

# ---- Anthropic formatter (reports / polish) ----
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_QUALITY=claude-sonnet-4-6
ANTHROPIC_TEMPERATURE=0.25
ANTHROPIC_MAX_TOKENS=1400

# ---- Agent execution ----
AGENT_MAX_REACT_ITERATIONS=4
AGENT_REACT_TIMEOUT_MS=18000
AGENT_FAST_FORMAT=true
AGENT_ALWAYS_VERIFY_WEB=true
AGENT_WEB_VERIFY_CACHE_TTL_MS=600000
