{
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm --filter @financial-agent/web build",
    "start": "pnpm --filter @financial-agent/web start",
    "dev": "pnpm --parallel --filter @financial-agent/api --filter @financial-agent/web dev",
    "deploy:api": "bash scripts/despliegue/deploy-api.sh",
    "deploy:web": "bash scripts/despliegue/deploy-web.sh",
    "qa:smoke": "pnpm --filter @financial-agent/api qa:smoke",
    "prod:smoke": "node scripts/qa/prod-smoke.mjs",
    "qa:budget-e2e": "tsx scripts/qa/prod-budget-e2e.ts",
    "qa:tx-modal": "node apps/web/scripts/qa/smoke-transactions-modal.mjs",
    "sync:latest": "bash scripts/mantenimiento/sync-latest.sh",
    "typecheck": "pnpm --filter @financial-agent/web typecheck && pnpm --filter @financial-agent/api typecheck",
    "test": "pnpm --filter @financial-agent/web test:ci && pnpm --filter @financial-agent/api test",
    "verify": "pnpm typecheck && pnpm --filter @financial-agent/web lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "pino-pretty": "^13.1.3",
    "pnpm": "^10.26.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "ws": "^8.20.1"
    }
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
