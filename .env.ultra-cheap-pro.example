# Ultra-cheap pro profile (production-oriented)
# Goal: keep senior output quality while minimizing average token/tool cost.
# Copy the values you want into your real .env (do not commit secrets).

# Required secrets (set real values in your environment)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ---- Core LLM routing (cost-optimized, still senior) ----
# Keep a solid primary model; route short prompts to mini automatically.
OPENAI_MODEL=gpt-4.1
OPENAI_MODEL_FAST=gpt-4.1-mini
OPENAI_MODEL_QUALITY=gpt-4.1
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_COMPLETION_TOKENS=1200
OPENAI_STRUCTURED_MAX_COMPLETION_TOKENS=700
OPENAI_PLAN_MAX_COMPLETION_TOKENS=700

# Formatter: fast path handles most turns; keep Sonnet for complex turns only.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_QUALITY=claude-sonnet-4-6
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_MAX_TOKENS=1200

# Balanced keeps quality on complex turns and savings on simple ones.
AGENT_LLM_BUDGET_MODE=balanced

# ---- Agent execution efficiency ----
# Adaptive iteration logic in code will cap lower per mode.
AGENT_MAX_REACT_ITERATIONS=3
AGENT_REACT_TIMEOUT_MS=12000

# Keep web grounding but with cache to reduce repeated calls.
AGENT_ALWAYS_VERIFY_WEB=true
AGENT_WEB_VERIFY_CACHE_TTL_MS=600000

# Use fast formatter for low/medium complexity turns.
AGENT_FAST_FORMAT=true

# ---- Frontend latency/cost guardrails ----
NEXT_PUBLIC_AGENT_TIMEOUT_MS=45000
NEXT_PUBLIC_AGENT_RETRY_TIMEOUT=true
NEXT_PUBLIC_AGENT_RETRY_5XX=true

# ---- Optional vision/OCR savings ----
OPENAI_VISION_MODEL=gpt-4o-mini
TRANSACTIONS_VISION_DETAIL=auto

# ---- Runtime ----
NODE_ENV=production
LOG_LEVEL=info
